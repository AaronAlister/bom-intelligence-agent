# ============================================================
# BOM Intelligence Agent
# Environment Configuration Template
# ============================================================

# Application
APP_NAME=BOM Intelligence Agent
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_DB=bom_intelligence
POSTGRES_USER=bom_admin
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://bom_admin:replace_with_a_secure_database_password@postgres:5432/bom_intelligence

# ============================================================
# Redis
# ============================================================

REDIS_URL=redis://redis:6379/0

# ============================================================
# Qdrant
# ============================================================

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=bom_documents

# ============================================================
# RAG / Embeddings
# ============================================================

EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
OPENAI_API_KEY=

# ============================================================
# LLM
# ============================================================

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ============================================================
# Distributor APIs
# ============================================================

# Mouser
MOUSER_API_KEY=
MOUSER_API_BASE_URL=https://api.mouser.com/api/v1
MOUSER_API_TIMEOUT_SECONDS=15

# Arrow
ARROW_API_LOGIN=
ARROW_API_KEY=
ARROW_API_BASE_URL=https://api.arrow.com
ARROW_API_TIMEOUT_SECONDS=15

# Digi-Key
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_API_BASE_URL=https://api.digikey.com
DIGIKEY_API_TIMEOUT_SECONDS=15
DIGIKEY_LOCALE_SITE=IN
DIGIKEY_LOCALE_LANGUAGE=en
DIGIKEY_LOCALE_CURRENCY=INR

# ============================================================
# Security
# ============================================================

SECRET_KEY=replace_with_a_long_random_secret

# ============================================================
# Upload Limits
# ============================================================

MAX_BOM_FILE_SIZE_MB=25